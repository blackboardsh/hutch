+fn claimConnectAttempt(attempts_remaining: *std.atomic.Value(usize)) bool {
+    var remaining = attempts_remaining.load(.monotonic);
+    while (remaining != 0) {
+        if (attempts_remaining.cmpxchgWeak(remaining, remaining - 1, .monotonic, .monotonic)) |actual| {
